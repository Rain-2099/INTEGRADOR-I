-- 1. Crear y usar la base de datos
CREATE DATABASE IF NOT EXISTS novagridx;
USE novagridx;

-- ==========================================
-- CREACIÓN DE TABLAS (ESTRUCTURA)
-- ==========================================

-- 2. Tabla de Métodos de Pago
CREATE TABLE IF NOT EXISTS payment_methods (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    status ENUM('Active', 'Inactive') DEFAULT 'Active'
);

-- 3. Tabla de Categorías
CREATE TABLE IF NOT EXISTS categories (
    id INT AUTO_INCREMENT PRIMARY KEY,
    types VARCHAR(100) NOT NULL,
    quantity INT DEFAULT 0,
    hierarchy VARCHAR(50)
);

-- 4. Tabla de Usuarios
CREATE TABLE IF NOT EXISTS users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    `password` VARCHAR(255) NOT NULL,
    user_id VARCHAR(10) NOT NULL UNIQUE,
    payment_method_id INT,
    create_date DATE NOT NULL,
    up_date DATE,
    role ENUM('Client', 'Artist', 'Both') NOT NULL,
    raiting DECIMAL(2,1) CHECK (raiting >= 0.0 AND raiting <= 5.0),
    
    CONSTRAINT fk_users_payment FOREIGN KEY (payment_method_id) 
        REFERENCES payment_methods(id) ON DELETE SET NULL ON UPDATE CASCADE
);

-- 5. Tabla de Publicaciones (Posts)
CREATE TABLE IF NOT EXISTS posts (
    id INT AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(150) NOT NULL,
    category_id INT NOT NULL,
    price DECIMAL(10,2) NOT NULL,
    available BOOLEAN DEFAULT TRUE,
    user_id INT NOT NULL,
    image_url VARCHAR(255),
    `date` DATE NOT NULL,
    type ENUM('Request', 'Art Piece', 'Commission Slot') NOT NULL,
    
    CONSTRAINT fk_posts_category FOREIGN KEY (category_id) 
        REFERENCES categories(id) ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT fk_posts_user FOREIGN KEY (user_id) 
        REFERENCES users(id) ON DELETE CASCADE ON UPDATE CASCADE
);

-- 6. Tabla de Ventas (Sales)
CREATE TABLE IF NOT EXISTS sales (
    id INT AUTO_INCREMENT PRIMARY KEY,
    product VARCHAR(150) NOT NULL,
    quantity DECIMAL(10,2) NOT NULL,
    post_id INT NOT NULL,
    user_id INT NOT NULL,
    confirmed ENUM('YES', 'PENDING', 'NO') DEFAULT 'PENDING',
    payment_method_id INT NOT NULL,
    
    CONSTRAINT fk_sales_post FOREIGN KEY (post_id) 
        REFERENCES posts(id) ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT fk_sales_user FOREIGN KEY (user_id) 
        REFERENCES users(id) ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT fk_sales_payment FOREIGN KEY (payment_method_id) 
        REFERENCES payment_methods(id) ON DELETE RESTRICT ON UPDATE CASCADE
);

-- 7. Tabla de Envíos (Shipping)
CREATE TABLE IF NOT EXISTS shipping (
    id INT AUTO_INCREMENT PRIMARY KEY,
    sale_id INT NOT NULL UNIQUE,
    type VARCHAR(50) NOT NULL,
    download_link VARCHAR(255),
    artist_confirmed BOOLEAN DEFAULT FALSE,
    client_confirmed BOOLEAN DEFAULT FALSE,
    status ENUM('Delivered', 'Pending', 'Cancelled') DEFAULT 'Pending',
    `date` DATE NOT NULL,
    
    CONSTRAINT fk_shipping_sale FOREIGN KEY (sale_id) 
        REFERENCES sales(id) ON DELETE CASCADE ON UPDATE CASCADE
);

